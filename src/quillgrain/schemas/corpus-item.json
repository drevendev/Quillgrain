{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "quillgrain.corpus-item/v1"
    },
    "id": {
      "type": "string"
    },
    "work_id": {
      "type": "string"
    },
    "source_kind": {
      "type": "string"
    },
    "source_alias": {
      "type": "string"
    },
    "relative_locator": {
      "type": "string"
    },
    "raw_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "extraction_profile": {
      "type": "string"
    },
    "extracted_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "language": {
      "type": "string"
    },
    "register": {
      "type": "string"
    },
    "authorship": {
      "enum": [
        "owner_declared_human",
        "human_edited",
        "ai_assisted",
        "quoted",
        "unknown"
      ]
    },
    "selection": {
      "enum": [
        "candidate",
        "reference",
        "holdout",
        "excluded"
      ]
    },
    "rights": {
      "type": "string"
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "local_analysis": {
          "type": "boolean"
        },
        "retrieval": {
          "type": "boolean"
        },
        "private_git_excerpt": {
          "type": "boolean"
        },
        "approved_model_hosts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "public_redistribution": {
          "type": "boolean"
        }
      },
      "required": [
        "local_analysis",
        "retrieval",
        "private_git_excerpt",
        "approved_model_hosts",
        "public_redistribution"
      ]
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "by": {
          "type": "string"
        },
        "basis": {
          "type": "string"
        }
      },
      "required": [
        "by",
        "basis"
      ]
    },
    "visibility": {
      "enum": [
        "public",
        "private",
        "local_only"
      ]
    },
    "ranges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "start_line": {
            "type": "integer",
            "minimum": 0
          },
          "end_line": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "start_line",
          "end_line"
        ]
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "duplicate_of": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "work_id",
    "source_kind",
    "source_alias",
    "relative_locator",
    "raw_sha256",
    "extraction_profile",
    "extracted_sha256",
    "language",
    "register",
    "authorship",
    "selection",
    "rights",
    "permissions",
    "approval",
    "visibility",
    "ranges",
    "limitations"
  ]
}
