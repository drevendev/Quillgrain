{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "quillgrain.corpus/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,159}$"
    },
    "version": {
      "type": "string"
    },
    "visibility": {
      "const": "private"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,159}$"
      }
    },
    "fragment_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,159}$"
      }
    },
    "protected_work_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,159}$"
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "by": {
          "type": "string"
        },
        "basis": {
          "type": "string"
        }
      },
      "required": [
        "by",
        "basis"
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "version",
    "visibility",
    "source_ids",
    "fragment_ids",
    "protected_work_ids",
    "approval"
  ]
}
