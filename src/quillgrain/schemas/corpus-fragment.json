{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "quillgrain.corpus-fragment/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,159}$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,159}$"
    },
    "revision_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "start": {
      "type": "integer",
      "minimum": 0
    },
    "end": {
      "type": "integer",
      "minimum": 0
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "channel": {
      "enum": [
        "narration",
        "dialogue"
      ]
    },
    "authorship": {
      "type": "string"
    },
    "status": {
      "enum": [
        "CANDIDATE",
        "REVIEWED",
        "RETIRED"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "source_id",
    "revision_id",
    "start",
    "end",
    "sha256",
    "channel",
    "authorship",
    "status",
    "tags"
  ]
}
